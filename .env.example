# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://contentcred:contentcred123@db:5432/contentcred_crm

# ── YouTube Data API ─────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# ── Spotify API ──────────────────────────────────────────────
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ── Instagram (use a dedicated dummy account) ─────────────────
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# ── TikTok ──────────────────────────────────────────────────
TIKTOK_SESSION_ID=your_tiktok_session_id   # from browser cookies

# ── Gmail SMTP (cold outreach) ───────────────────────────────
GMAIL_ADDRESS=team.contentcred@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password  # 16-char Google App Password

# ── Calendly ────────────────────────────────────────────────
CALENDLY_LINK=https://calendly.com/contentcred-strategy/content-distribution-strategy-call

# ── Sender Identity ──────────────────────────────────────────
SENDER_NAME=Devvendar
REPLY_TO_EMAIL=team.contentcred@gmail.com

# ── Outreach Limits ──────────────────────────────────────────
DAILY_EMAIL_LIMIT=200
DAILY_INSTAGRAM_DM_LIMIT=50

# ── Scraper Config ───────────────────────────────────────────
DAILY_SCRAPE_TARGET=1000
SCRAPE_HOUR=6        # 6:00 AM
OUTREACH_HOUR=10     # 10:00 AM

# ── Public API URL (for email open tracking) ──────────────────
API_BASE_URL=http://YOUR_VPS_IP:8001

# ── Proxy (optional but recommended) ─────────────────────────
PROXY_URL=http://user:pass@proxy-host:port
